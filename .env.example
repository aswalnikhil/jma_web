# Copy this file to .env.local and fill in your Razorpay keys.
# Dashboard → Account & Settings → API Keys (https://dashboard.razorpay.com/app/website-app-settings/api-keys)
# Use test-mode keys (rzp_test_…) while testing, live keys (rzp_live_…) in production.
RAZORPAY_KEY_ID=
# Secret: server-only. Never prefix with NEXT_PUBLIC_, never commit it.
RAZORPAY_KEY_SECRET=
